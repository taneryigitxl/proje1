generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String      @id @default(cuid())
  username     String
  usernameKey  String      @unique
  email        String
  emailKey     String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  characters   Character[]
}

model Character {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  nameKey       String   @unique
  gender        String
  hairStyle     String
  hairColor     String
  level         Int      @default(1)
  experience    Int      @default(0)
  gold          Int      @default(0)
  currentHealth Int      @default(100)
  maxHealth     Int      @default(100)
  currentMana   Int      @default(50)
  maxMana       Int      @default(50)
  mapId         String   @default("tora-village")
  positionX     Float
  positionY     Float
  facing        String   @default("down")
  classId       String   @default("warrior")
  strength      Int      @default(8)
  dexterity     Int      @default(5)
  intellect     Int      @default(4)
  vitality      Int      @default(8)
  statPoints    Int      @default(0)
  createdAt     DateTime @default(now())
  lastLogin     DateTime @default(now())
  items         InventoryItem[]

  @@index([accountId])
}

model InventoryItem {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemId      String
  slot        Int
  quantity    Int       @default(1)
  equipped    Boolean   @default(false)

  @@unique([characterId, slot])
}
