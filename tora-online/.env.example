# Node game server (PostgreSQL and WebSocket cannot run on GitHub Pages)
DATABASE_URL=postgres://tora:replace-me@127.0.0.1:5432/tora_online
POSTGRES_PASSWORD=replace-with-a-long-random-password
GAME_SERVER_PORT=8080
ALLOWED_ORIGINS=https://yigittaner.online
NODE_ENV=production
TRUST_LOOPBACK_PROXY=true

# Vite build-time client variable; set to your HTTPS game API origin.
VITE_GAME_API_URL=https://game.yigittaner.online
